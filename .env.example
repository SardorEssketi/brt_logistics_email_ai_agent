# Copy to .env for LOCAL testing only. On the server, install.sh creates /etc/driver-outreach/outreach.env.
# Never commit real values.

PUBLIC_BASE_URL=http://localhost:8000
ADMIN_USER=admin
# Generate with: python -c "from core.crypto import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
DATA_DIR=./data
GOOGLE_SA_FILE=./secrets/google-service-account.json
# 1 = emails are saved as .eml files in DATA_DIR/outbox instead of being sent (notes still written)
DRY_RUN=1
# Local demos only: in dry-run mode, ignore the sending window and the 90-300 s gaps
DRY_RUN_FAST=0
# Local http (no HTTPS) needs this
COOKIE_SECURE=0
